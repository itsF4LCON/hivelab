#!/bin/sh
set -eu

LAB=/opt/lab
STATE=/var/lib/lab
DB="$LAB/challenges.json"

valid() { [ -n "$(jq -r --arg id "$1" '.[] | select(.id == $id) | .id' "$DB")" ]; }

case ${1:-} in
start)
	id=${2:-}
	valid "$id" || { echo "unknown challenge" >&2; exit 1; }
	rm -rf /home/learner/challenge "$STATE/flag.sha256" "$STATE/hints" "$STATE/answered"
	mkdir -p /home/learner/challenge
	if [ "$(jq -r --arg id "$id" '.[] | select(.id == $id) | .root' "$DB")" = true ]; then
		echo "permit nopass learner" >/etc/doas.d/challenge.conf
	else
		rm -f /etc/doas.d/challenge.conf
	fi
	cd /home/learner/challenge
	LAB_FILES="$LAB/c/$id/files" STATE="$STATE" sh -eu -c ". $LAB/lib.sh; . $LAB/c/$id/setup.sh"
	chown -R learner:learner /home/learner/challenge
	echo "$id" >"$STATE/current"
	chown learner:learner "$STATE/current"
	;;
check)
	id=$(cat "$STATE/current")
	valid "$id" && [ -x "$LAB/c/$id/check.sh" ] || exit 1
	sh -eu -c ". $LAB/lib.sh; . $LAB/c/$id/check.sh"
	;;
*)
	echo "usage: lab-root start <id> | check" >&2
	exit 1
	;;
esac
